# VCET AI Chatbot - Environment Configuration
# Copy this file to .env and fill in your values

# ===========================
# Required Configuration
# ===========================

# Groq API Key (Get from: https://console.groq.com)
# This is the default/fallback API key used by the server
# Note: Users can also provide their own API keys through the Settings UI
GROQ_API_KEY=your_groq_api_key_here

# ===========================
# Optional Configuration
# ===========================

# AI Models
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# Check which chat models your Groq project actually allows at
# https://console.groq.com/settings/project/limits before changing this.
LLM_MODEL=qwen/qwen3.6-27b

# Flask Configuration
SECRET_KEY=vcet-rag-chatbot-secret-key-2024
DEBUG=False
PORT=5000

# RAG Settings
TOP_K_RESULTS=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Rate Limiting
RATE_LIMIT_ENABLED=True
MAX_REQUESTS_PER_MINUTE=30

# CORS
CORS_ORIGINS=*

# Logging
LOG_LEVEL=INFO
LOG_FILE=vcet_chatbot.log

# ===========================
# New RAG Ecosystem (rag/settings.py, api/)
# ===========================

# Ingestion
DATA_DIR=data
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Vector store (Chroma)
CHROMA_DIR=chroma_store
CHROMA_COLLECTION=vcet_docs
TOP_K=5

# Re-ranking: fetch RERANK_CANDIDATE_POOL chunks by cosine similarity, then re-score
# each with a cross-encoder (query+doc read jointly) and keep the top TOP_K.
RERANK_ENABLED=True
RERANKER_MODEL=BAAI/bge-reranker-base
RERANK_CANDIDATE_POOL=20

# HyDE: when the raw query's best cosine similarity is below this, generate a short
# hypothetical answer with the LLM and search with its embedding too (helps short/vague
# student questions match document-style phrasing). Set HYDE_ENABLED=False to disable.
HYDE_ENABLED=True
HYDE_SCORE_THRESHOLD=0.45

# Dual retrieval routing
# Web search fires when internal top similarity < this, or internal results are empty,
# or the query matches a temporal trigger word ("latest", "today", "current", etc.)
RETRIEVAL_SCORE_THRESHOLD=0.35
# Provider: duckduckgo (no key needed) | tavily | serper (both need their own API key wired in later)
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_MAX_RESULTS=4

# Conversation memory (SQLite)
SQLITE_PATH=rag_memory.db
HISTORY_TOKEN_BUDGET=1500
MAX_HISTORY_MESSAGES=20

# Admin endpoints (e.g. POST /api/admin/reindex) — change this in production
ADMIN_TOKEN=changeme-admin-token

# ===========================
# Notes
# ===========================
# - Never commit the .env file to version control
# - Keep your API keys secure
# - Adjust settings based on your needs
